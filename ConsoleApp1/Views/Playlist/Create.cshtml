@model PlaylistApp.Models.DTOs.CreatePlaylistDto

<div class="container mt-4" style="max-width: 700px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Create New Playlist</h4>
            <a asp-action="Index" class="btn btn-outline-light btn-sm">Cancel</a>
        </div>
        <div class="card-body">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Playlist Title</label>
                    <input asp-for="Title" class="form-control" placeholder="e.g. OPM Chill Hits" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <h5 class="mt-4 mb-3">Track List (YouTube Links)</h5>

                @for (int i = 0; i < Model.Videos.Count; i++)
                {
                    <div class="card mb-3 border-light bg-light">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary">Track #@(i + 1)</span>
                                @if (Model.Videos.Count > 1)
                                {
                                    <button type="submit"
                                            asp-action="RemoveVideoRow"
                                            asp-route-index="@i"
                                            formnovalidate
                                            class="btn btn-outline-danger btn-sm">
                                        Remove
                                    </button>
                                }
                            </div>
                            <div class="mb-2">
                                <input name="Videos[@i].YouTubeUrl"
                                       value="@Model.Videos[i].YouTubeUrl"
                                       class="form-control"
                                       placeholder="YouTube URL" />
                            </div>
                            <div>
                                <input name="Videos[@i].TrackNote"
                                       value="@Model.Videos[i].TrackNote"
                                       class="form-control"
                                       placeholder="Track Note" />
                            </div>
                        </div>
                    </div>
                }

                <div class="mb-4">
                    <button type="submit" asp-action="AddVideoRow" formnovalidate class="btn btn-outline-primary w-100">
                        + Add Another Track
                    </button>
                </div>

                <hr />

                <div class="d-grid">
                    <button type="submit" asp-action="Save" class="btn btn-success btn-lg">
                        Save Complete Playlist
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
